@{
    ViewData["Title"] = "Plataforma Cloud & Servicios Web";
}

<!-- Hero Section -->
<section class="hero-section position-relative overflow-hidden">
    <div class="hero-background-glow"></div>
    <div class="container position-relative py-5">
        <div class="row align-items-center g-5 py-lg-4">
            <div class="col-lg-7 text-center text-lg-start">
                <div class="inline-badge mb-3 d-inline-flex align-items-center gap-2">
                    <span class="live-pulse"></span>
                    <span class="badge-text">Plataforma Cloud Activa • ASP.NET Core</span>
                </div>
                <h1 class="hero-title display-4 fw-extrabold mb-3">
                    Infraestructura Cloud Escalable y de <span class="gradient-text">Alto Rendimiento</span>
                </h1>
                <p class="hero-lead text-muted lead mb-4">
                    Desarrolla, despliega y administra aplicaciones empresariales modernas con la solidez de .NET y los servicios resilientes del ecosistema Azure.
                </p>
                <div class="d-flex flex-wrap justify-content-center justify-content-lg-start gap-3">
                    <a href="#servicios" class="btn btn-primary btn-lg px-4 rounded-pill shadow-sm d-inline-flex align-items-center gap-2">
                        <span>Explorar Soluciones</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                    <a href="#flujo" class="btn btn-outline-secondary btn-lg px-4 rounded-pill d-inline-flex align-items-center gap-2">
                        <i class="bi bi-diagram-3"></i>
                        <span>Flujo de Arquitectura</span>
                    </a>
                </div>
                
                <div class="mt-4 pt-3 border-top d-flex flex-wrap justify-content-center justify-content-lg-start align-items-center gap-4 text-muted small">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check2-circle text-primary fs-6"></i>
                        <span>Arquitectura Serverless y PaaS</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-primary fs-6"></i>
                        <span>Cumplimiento Zero Trust</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-speedometer2 text-primary fs-6"></i>
                        <span>Optimizado para .NET</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="hero-visual-card shadow-lg p-4 rounded-4 bg-white border">
                    <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <span class="card-dot bg-danger"></span>
                            <span class="card-dot bg-warning"></span>
                            <span class="card-dot bg-success"></span>
                            <span class="text-muted font-monospace small ms-2">azureweb-node-01</span>
                        </div>
                        <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill small">En línea</span>
                    </div>

                    <div class="system-stats-grid mb-3">
                        <div class="stat-box p-3 rounded-3 bg-light">
                            <div class="text-muted small">Estado de Red</div>
                            <div class="fw-bold text-dark mt-1">Óptimo (12ms)</div>
                        </div>
                        <div class="stat-box p-3 rounded-3 bg-light">
                            <div class="text-muted small">Cargas Activas</div>
                            <div class="fw-bold text-dark mt-1">99.98% Rendimiento</div>
                        </div>
                    </div>

                    <div class="console-box p-3 rounded-3 font-monospace small">
                        <div class="text-secondary mb-1"># Diagnóstico del entorno</div>
                        <div class="text-success">&gt; dotnet --info <span class="text-muted">[Activo]</span></div>
                        <div class="text-info">&gt; azure.connect.region: eastus2</div>
                        <div class="text-light">&gt; status: 200 OK • Microservicios sincronizados</div>
                    </div>

                    <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center small text-muted">
                        <span>Último sync: Hoy</span>
                        <a asp-controller="Home" asp-action="Privacy" class="text-primary text-decoration-none">Políticas de seguridad &rarr;</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Métricas de Impacto -->
<section id="metricas" class="py-5 bg-surface border-top border-bottom">
    <div class="container py-2">
        <div class="row g-4 text-center">
            <div class="col-6 col-md-3">
                <div class="metric-card p-3 rounded-3 h-100">
                    <div class="metric-value text-primary display-6 fw-bold">99.99%</div>
                    <div class="metric-label fw-semibold text-dark mt-1">Disponibilidad SLA</div>
                    <p class="text-muted small mb-0 mt-1">Continuidad de negocio sin interrupciones</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="metric-card p-3 rounded-3 h-100">
                    <div class="metric-value text-primary display-6 fw-bold">&lt;15ms</div>
                    <div class="metric-label fw-semibold text-dark mt-1">Latencia Media</div>
                    <p class="text-muted small mb-0 mt-1">Enrutamiento acelerado global</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="metric-card p-3 rounded-3 h-100">
                    <div class="metric-value text-primary display-6 fw-bold">100%</div>
                    <div class="metric-label fw-semibold text-dark mt-1">Cifrado de Extremo</div>
                    <p class="text-muted small mb-0 mt-1">Protección AES-256 y TLS 1.3</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="metric-card p-3 rounded-3 h-100">
                    <div class="metric-value text-primary display-6 fw-bold">24/7</div>
                    <div class="metric-label fw-semibold text-dark mt-1">Monitoreo Proactivo</div>
                    <p class="text-muted small mb-0 mt-1">Telemetría con Application Insights</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Servicios Grid -->
<section id="servicios" class="py-5">
    <div class="container py-4">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="text-primary fw-bold text-uppercase tracking-wide small">Ecosistema Cloud</span>
            <h2 class="display-6 fw-bold mt-2">Capacidades Centrales para Aplicaciones Críticas</h2>
            <p class="text-muted">
                Herramientas integradas para desarrollo ágil, despliegues automáticos y escalabilidad elástica.
            </p>
        </div>

        <div class="row g-4">
            <!-- Card 1 -->
            <div class="col-md-6 col-lg-4">
                <div class="service-card h-100 p-4 rounded-4 bg-white border">
                    <div class="service-icon-wrapper mb-3 text-primary">
                        <i class="bi bi-cpu fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Cómputo Elástico</h5>
                    <p class="text-muted small mb-3">
                        Ejecución en Azure App Services y contenedores Docker con balanceo de carga automático y autoescalado según demanda.
                    </p>
                    <ul class="list-unstyled small text-muted mb-0">
                        <li class="d-flex align-items-center gap-2 mb-1"><i class="bi bi-chevron-right text-primary"></i> Despliegue sin tiempo de inactividad</li>
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-chevron-right text-primary"></i> Aislamiento de procesos por slot</li>
                    </ul>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="col-md-6 col-lg-4">
                <div class="service-card h-100 p-4 rounded-4 bg-white border">
                    <div class="service-icon-wrapper mb-3 text-primary">
                        <i class="bi bi-database-check fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Bases de Datos Gestionadas</h5>
                    <p class="text-muted small mb-3">
                        Integración nativa con Azure SQL y Azure Cosmos DB con replicación global, respaldos instantáneos y alta consistencia.
                    </p>
                    <ul class="list-unstyled small text-muted mb-0">
                        <li class="d-flex align-items-center gap-2 mb-1"><i class="bi bi-chevron-right text-primary"></i> Compatibilidad con Entity Framework Core</li>
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-chevron-right text-primary"></i> Migraciones automatizadas en release</li>
                    </ul>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="col-md-6 col-lg-4">
                <div class="service-card h-100 p-4 rounded-4 bg-white border">
                    <div class="service-icon-wrapper mb-3 text-primary">
                        <i class="bi bi-cloud-arrow-up fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Almacenamiento y CDN</h5>
                    <p class="text-muted small mb-3">
                        Blob Storage con redundancia local y geográfica para assets estáticos, archivos multimedia y descargas ultrarrápidas vía CDN.
                    </p>
                    <ul class="list-unstyled small text-muted mb-0">
                        <li class="d-flex align-items-center gap-2 mb-1"><i class="bi bi-chevron-right text-primary"></i> Niveles Hot, Cool y Archive</li>
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-chevron-right text-primary"></i> Control de acceso mediante SAS tokens</li>
                    </ul>
                </div>
            </div>

            <!-- Card 4 -->
            <div class="col-md-6 col-lg-4">
                <div class="service-card h-100 p-4 rounded-4 bg-white border">
                    <div class="service-icon-wrapper mb-3 text-primary">
                        <i class="bi bi-shield-lock fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Seguridad y Gobernanza</h5>
                    <p class="text-muted small mb-3">
                        Autenticación corporativa mediante Microsoft Entra ID (Azure AD), gestión centralizada de secretos con Azure Key Vault.
                    </p>
                    <ul class="list-unstyled small text-muted mb-0">
                        <li class="d-flex align-items-center gap-2 mb-1"><i class="bi bi-chevron-right text-primary"></i> Políticas de acceso condicional</li>
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-chevron-right text-primary"></i> Auditoría y trazabilidad integral</li>
                    </ul>
                </div>
            </div>

            <!-- Card 5 -->
            <div class="col-md-6 col-lg-4">
                <div class="service-card h-100 p-4 rounded-4 bg-white border">
                    <div class="service-icon-wrapper mb-3 text-primary">
                        <i class="bi bi-git fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-2">DevOps & CI/CD Continuo</h5>
                    <p class="text-muted small mb-3">
                        Pipelines de validación y publicación directa desde repositorios GitHub o Azure Repos hacia entornos de staging y producción.
                    </p>
                    <ul class="list-unstyled small text-muted mb-0">
                        <li class="d-flex align-items-center gap-2 mb-1"><i class="bi bi-chevron-right text-primary"></i> Pruebas unitarias automatizadas</li>
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-chevron-right text-primary"></i> Rollback instantáneo ante incidentes</li>
                    </ul>
                </div>
            </div>

            <!-- Card 6 -->
            <div class="col-md-6 col-lg-4">
                <div class="service-card h-100 p-4 rounded-4 bg-white border">
                    <div class="service-icon-wrapper mb-3 text-primary">
                        <i class="bi bi-graph-up-arrow fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Telemetría y Observabilidad</h5>
                    <p class="text-muted small mb-3">
                        Detección proactiva de cuellos de botella con Application Insights, registros de transacciones y mapas de dependencias en vivo.
                    </p>
                    <ul class="list-unstyled small text-muted mb-0">
                        <li class="d-flex align-items-center gap-2 mb-1"><i class="bi bi-chevron-right text-primary"></i> Alertas automáticas por umbrales</li>
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-chevron-right text-primary"></i> Trazas de peticiones HTTP en tiempo real</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Flujo de Arquitectura -->
<section id="flujo" class="py-5 bg-surface border-top border-bottom">
    <div class="container py-4">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="text-primary fw-bold text-uppercase tracking-wide small">Ciclo de Vida</span>
            <h2 class="display-6 fw-bold mt-2">Cómo Funciona la Arquitectura</h2>
            <p class="text-muted">Un flujo simplificado y estandarizado desde el código fuente hasta la entrega al usuario final.</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="step-card p-4 rounded-4 bg-white border h-100">
                    <div class="step-number text-primary fw-bold mb-2">01</div>
                    <h5 class="fw-bold mb-2">Desarrollo y Commit</h5>
                    <p class="text-muted small mb-0">
                        Desarrolladores trabajan con el SDK de .NET, asegurando tipado estricto, pruebas unitarias y sincronización con el repositorio central.
                    </p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="step-card p-4 rounded-4 bg-white border h-100">
                    <div class="step-number text-primary fw-bold mb-2">02</div>
                    <h5 class="fw-bold mb-2">Build y Verificación CI</h5>
                    <p class="text-muted small mb-0">
                        Los runners automatizados compilan los ensamblados, ejecutan análisis estático de código y empaquetan los contenedores listos para producción.
                    </p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="step-card p-4 rounded-4 bg-white border h-100">
                    <div class="step-number text-primary fw-bold mb-2">03</div>
                    <h5 class="fw-bold mb-2">Despliegue y Escalamiento</h5>
                    <p class="text-muted small mb-0">
                        Azure App Service distribuye la versión hacia los nodos de producción con cero tiempo de baja e inicio rápido de instancias.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call To Action Final -->
<section id="contacto" class="py-5">
    <div class="container py-4">
        <div class="cta-banner p-5 rounded-4 text-white position-relative overflow-hidden">
            <div class="cta-glow"></div>
            <div class="row align-items-center position-relative g-4">
                <div class="col-lg-8 text-center text-lg-start">
                    <h2 class="display-6 fw-bold mb-2">¿Listo para desplegar tu siguiente solución?</h2>
                    <p class="text-white-50 lead mb-0">
                        Consulta la documentación oficial de ASP.NET Core y comienza a estructurar tus servicios en la nube hoy mismo.
                    </p>
                </div>
                <div class="col-lg-4 text-center text-lg-end">
                    <a href="https://learn.microsoft.com/aspnet/core" target="_blank" rel="noopener" class="btn btn-light btn-lg px-4 rounded-pill fw-bold text-primary shadow">
                        Ir a Documentación
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
